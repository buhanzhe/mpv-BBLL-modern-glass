<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BBLL · NewBV for mpv" Width="1280" Height="720" MinWidth="640" MinHeight="390"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#303030" Foreground="#EEE" FontFamily="Microsoft YaHei UI, Segoe UI" xml:lang="zh-CN"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
        </Style>
        <Style x:Key="DialogOption" TargetType="Button">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionFill" Background="{TemplateBinding Background}" Padding="36,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionFill" Property="Background" Value="#4D4655"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OptionFill" Property="Background" Value="#655977"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="OptionFill" Property="Background" Value="#726485"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border Background="#818181"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusBorder" Property="Background" Value="#64527E"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="Background" Value="#715C91"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DynamicCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DynamicCardFill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="DynamicCardFill" Property="Background" Value="#715C91"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowControl" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#505050"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#715C90"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HeaderTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="53"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#909090"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="TabFocus" BorderThickness="1" CornerRadius="3" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabFocus" Property="BorderBrush" Value="#BA99E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#EEEEEE"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#EEEEEE"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="47"/>
            <Setter Property="Height" Value="47"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RailFill" Background="{TemplateBinding Background}" CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RailFill" Property="Background" Value="#535353"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RailFill" Property="Background" Value="#626262"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HotSearch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="24" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="#64527E"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Pill" Property="Background" Value="#715C91"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CommentRow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CommentFocus" CornerRadius="5" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CommentFocus" Property="Background" Value="#383838"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CommentFocus" Property="Background" Value="#363636"/>
                                <Setter TargetName="CommentFocus" Property="BorderBrush" Value="#00AEEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsCategory" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CategoryFill" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryFill" Property="Background" Value="#535353"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CategoryFill" Property="Background" Value="#626262"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Image x:Name="Backdrop" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Grid x:Name="MainView">
            <Grid.ColumnDefinitions><ColumnDefinition Width="67"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="1" Background="#424242" Margin="0,80,0,80"/>
            <DockPanel Grid.Column="0" Margin="0,21,0,21" LastChildFill="False">
                <StackPanel x:Name="Sidebar" DockPanel.Dock="Top"/>
                <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" Style="{StaticResource RailButton}"/>
                <Button x:Name="AccountButton" DockPanel.Dock="Bottom" Margin="0,0,0,13" Style="{StaticResource RailButton}"/>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="69"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel x:Name="Header" Grid.Row="0" LastChildFill="True" Margin="0,0,131,0" Background="Transparent">
                    <Grid DockPanel.Dock="Right" Height="52" Margin="0,16,10,0" VerticalAlignment="Top">
                        <TextBlock x:Name="ClockText" VerticalAlignment="Center"
                                   FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="30" FontWeight="SemiBold"
                                   TextOptions.TextFormattingMode="Ideal"
                                   Typography.NumeralAlignment="Tabular">
                            <Run x:Name="ClockPeriod" FontSize="24" BaselineAlignment="Center"/><Run x:Name="ClockValue"/>
                        </TextBlock>
                    </Grid>
                    <ScrollViewer x:Name="HeaderScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="HeaderTabs" Orientation="Horizontal" Margin="20,16,0,0"/>
                    </ScrollViewer>
                </DockPanel>
                <ScrollViewer x:Name="Viewport" Grid.Row="1" Margin="7,7,7,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                              PanningMode="VerticalOnly" Focusable="False">
                    <StackPanel x:Name="Body"/>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="24,0,24,0" Visibility="Collapsed">
                    <Viewbox Width="116" Height="116" Margin="0,0,0,20" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Canvas Width="120" Height="120">
                            <Ellipse Width="120" Height="120" Fill="#3D3746"/>
                            <Path Data="M28,55 L60,41 L92,55 L92,82 L60,96 L28,82 Z"
                                  Fill="#544962" Stroke="#C4ADE4" StrokeThickness="2" StrokeLineJoin="Round"/>
                            <Path Data="M28,55 L60,69 L92,55 M60,69 V96 M43,30 V40 M38,35 H48 M77,33 H85"
                                  Stroke="#C4ADE4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="EmptyMessage" FontSize="20" Foreground="#E2E2E2"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="EmptyAction" Width="132" Height="52" Margin="0,18,0,0" Background="#424242"
                            HorizontalAlignment="Center" Style="{StaticResource HotSearch}">
                        <TextBlock x:Name="EmptyActionText" TextAlignment="Center"/>
                    </Button>
                </StackPanel>
                <DockPanel x:Name="StatusLayer" Grid.Row="1" Margin="18,0,14,12" Height="40" VerticalAlignment="Bottom" Background="#E52E2539" Visibility="Collapsed">
                    <Button x:Name="MoreButton" DockPanel.Dock="Right" Width="96" Visibility="Collapsed"/>
                    <TextBlock x:Name="StatusText" Margin="10,0" VerticalAlignment="Center" FontSize="16" Foreground="#EEE" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </Grid>
        <Grid x:Name="SettingsView" Background="#303030" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel x:Name="SettingsHeader" Grid.Row="0" Margin="20,10,138,26" Background="Transparent">
                <Button x:Name="SettingsBack" DockPanel.Dock="Left" Width="66" Height="48"/>
                <TextBlock Text="设置" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="296"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="SettingsCategories" Grid.Column="0" Margin="20,10,20,0"/>
                <Border Grid.Column="1" Background="#424242" Margin="0,22,0,40"/>
                <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" Margin="33,1,33,20"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <StackPanel x:Name="SettingsRows"/>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Grid x:Name="ProfileOverlay" Background="#99000000" Visibility="Collapsed" Focusable="True"
              KeyboardNavigation.IsTabStop="False" Panel.ZIndex="9">
            <Grid Width="334" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#424242" CornerRadius="14" Margin="0,67,0,0">
                    <Grid>
                        <StackPanel Margin="16,79,16,0">
                            <TextBlock x:Name="ProfileName" FontSize="26" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                            <StackPanel x:Name="ProfileDetails">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="24" Margin="0,6,0,0">
                                    <Border x:Name="ProfileVip" Background="#EA5D8E" CornerRadius="11" Padding="6,0"
                                            Margin="0,0,6,0" ToolTip="大会员">
                                        <TextBlock Text="大会员" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ProfileLevelBadge" Background="#E54D3B" MinWidth="48" Padding="6,0">
                                        <TextBlock x:Name="ProfileLevel" FontSize="16" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ProfileCoins" FontSize="17" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <UniformGrid Columns="3" Margin="-16,14,-16,0" TextBlock.FontSize="19" TextBlock.TextAlignment="Center">
                                    <StackPanel><TextBlock x:Name="ProfileFollowing"/><TextBlock Text="关注"/></StackPanel>
                                    <StackPanel><TextBlock x:Name="ProfileFollowers"/><TextBlock Text="粉丝"/></StackPanel>
                                    <StackPanel><TextBlock x:Name="ProfileDynamics"/><TextBlock Text="动态"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                            <TextBlock x:Name="ProfileStatus" FontSize="17" TextAlignment="Center" Margin="0,16,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <UniformGrid Rows="1" Height="48" Margin="8,0,8,6" VerticalAlignment="Bottom">
                            <Button x:Name="ProfileSpace" Content="我的空间" FontWeight="SemiBold"/>
                            <Button x:Name="ProfileSession" FontWeight="SemiBold"/>
                        </UniformGrid>
                    </Grid>
                </Border>
                <Grid x:Name="ProfileAvatar" Width="132" Height="132" VerticalAlignment="Top"
                      HorizontalAlignment="Center" Background="#E4E8ED">
                    <Grid.Clip><EllipseGeometry Center="66,66" RadiusX="66" RadiusY="66"/></Grid.Clip>
                    <Image x:Name="ProfileAvatarImage" Stretch="UniformToFill"/>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="DialogOverlay" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="10">
            <Border x:Name="DialogCard" Background="#3E3E3E" CornerRadius="2" Width="655" MaxHeight="636"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,18"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DialogTitle" Foreground="#EEEEEE" FontSize="29" Margin="36,12,36,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ScrollViewer x:Name="DialogScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DialogScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="DialogOptions"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="SignInOverlay" Background="#303030" Visibility="Collapsed" Panel.ZIndex="11">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel x:Name="SignInHeader" Margin="20,10,138,26" Background="Transparent">
                <Button x:Name="SignInCancel" DockPanel.Dock="Left" Width="66" Height="48" Content="‹"
                        FontSize="34" ToolTip="返回" AutomationProperties.Name="返回"/>
                <TextBlock Text="登录" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="38,24,38,40">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Viewbox MaxWidth="326" MaxHeight="326" Margin="20" Stretch="Uniform" StretchDirection="DownOnly"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="326" Height="326" Background="White">
                        <Image x:Name="SignInImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Viewbox>
                <Border Grid.Column="1" Background="#464646" Margin="0,20,0,20"/>
                <StackPanel Grid.Column="2" MaxWidth="384" Margin="26,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="扫描二维码登录" FontSize="27" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="打开哔哩哔哩 App，点「我的」右上角的扫一扫"
                               Margin="0,10,0,22" FontSize="18" Foreground="#C8C8C8" TextWrapping="Wrap"/>
                    <Button x:Name="SignInCheck" Height="54" Background="#424242" Style="{StaticResource HotSearch}">
                        <TextBlock Text="检查扫码状态" TextAlignment="Center"/>
                    </Button>
                    <TextBlock x:Name="SignInStatus" FontSize="16" Foreground="#D4D4D4" TextWrapping="Wrap"
                               Margin="0,16,0,0" MinHeight="26"/>
                    <Button x:Name="SignInRetry" Content="重新生成二维码" Margin="0,8,0,0" MinHeight="38"
                            Foreground="#C398F6" HorizontalAlignment="Right" Padding="8,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Height="52" Margin="0,16,14,0" Panel.ZIndex="12">
            <Button x:Name="MinimizeButton" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化"
                    Style="{StaticResource WindowControl}"/>
            <Button x:Name="FullscreenButton" Content="&#xE922;" ToolTip="全屏 (F11)" AutomationProperties.Name="全屏"
                    Style="{StaticResource WindowControl}"/>
            <Button x:Name="CloseWindowButton" Content="&#xE8BB;" ToolTip="关闭选片窗口" AutomationProperties.Name="关闭选片窗口"
                    Style="{StaticResource WindowControl}"/>
        </StackPanel>
    </Grid>
</Window>
